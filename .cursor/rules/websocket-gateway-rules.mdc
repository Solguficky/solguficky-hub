## NATS Integration

### IHostedService для подписки
```csharp
public class NatsEventListener : BackgroundService
{
    private readonly IConnection _natsConnection;
    private readonly IHubContext<AuctionHub> _hubContext;
    private readonly ILogger<NatsEventListener> _logger;

    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
        var subscription = _natsConnection.SubscribeAsync("events.auction.*");

        await foreach (var msg in subscription.Messages.WithCancellation(stoppingToken))
        {
            await ProcessEventAsync(msg, stoppingToken);
        }
    }

    private async Task ProcessEventAsync(Msg msg, CancellationToken ct)
    {
        try
        {
            var auctionId = ExtractAuctionId(msg);
            var eventData = DeserializeEvent(msg);

            await _hubContext.Clients
                .Group($"auction:{auctionId}")
                .SendAsync("AuctionEvent", eventData, ct);

            _logger.LogInformation("Event broadcasted",
                new { Subject = msg.Subject, AuctionId = auctionId });
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to process event",
                new { Subject = msg.Subject });
        }
    }
}
```

## Protobuf → JSON Mapping

### Десериализация и конвертация
```csharp
private object DeserializeEvent(Msg msg)
{
    return msg.Subject switch
    {
        "events.auction.bid_placed" => MapBidPlacedEvent(
            BidPlacedEvent.Parser.ParseFrom(msg.Data)
        ),
        "events.auction.lot_activated" => MapLotActivatedEvent(
            LotActivatedEvent.Parser.ParseFrom(msg.Data)
        ),
        _ => new { type = "unknown", subject = msg.Subject }
    };
}

private object MapBidPlacedEvent(BidPlacedEvent evt)
{
    return new
    {
        type = "bid_placed",
        data = new
        {
            lot_id = evt.LotId,
            amount = evt.Amount,
            bidder_name = evt.BidderName,
            timestamp = evt.Timestamp
        }
    };
}
```

