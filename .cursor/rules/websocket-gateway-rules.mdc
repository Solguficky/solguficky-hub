## SignalR Hubs

### Naming Conventions
- Hub classes: `*Hub` (e.g., `AuctionHub`, `AdminHub`)
- Client methods: PascalCase (`SendAsync("AuctionEvent", ...)`)
- Server methods: PascalCase (`SubscribeToAuction`, `UnsubscribeFromAuction`)

### Hub Implementation
```csharp
public class AuctionHub : Hub
{
    private readonly ILogger<AuctionHub> _logger;

    public AuctionHub(ILogger<AuctionHub> logger)
    {
        _logger = logger;
    }

    public async Task SubscribeToAuction(string auctionId)
    {
        await Groups.AddToGroupAsync(Context.ConnectionId, $"auction:{auctionId}");

        _logger.LogInformation("Client subscribed to auction",
            new { ConnectionId = Context.ConnectionId, AuctionId = auctionId });
    }

    public async Task UnsubscribeFromAuction(string auctionId)
    {
        await Groups.RemoveFromGroupAsync(Context.ConnectionId, $"auction:{auctionId}");

        _logger.LogInformation("Client unsubscribed from auction",
            new { Context.ConnectionId, AuctionId = auctionId });
    }

    public override async Task OnConnectedAsync()
    {
        _logger.LogInformation("Client connected",
            new { Context.ConnectionId });
        await base.OnConnectedAsync();
    }

    public override async Task OnDisconnectedAsync(Exception? exception)
    {
        _logger.LogInformation("Client disconnected",
            new { Context.ConnectionId, Exception = exception?.Message });
        await base.OnDisconnectedAsync(exception);
    }
}
```

