{
	"folders": [
		{
			"name": "Solguficky Hub",
			"path": "./"
		},
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.DS_Store": true,
			"**/.env": false
		},
		"explorer.compactFolders": true,
		"explorer.excludeGitIgnore": true,
		"editor.formatOnSave": true,
		"editor.rulers": [
			100
		],
		"files.trimTrailingWhitespace": true,
		"explorer.fileNesting.enabled": true,
		"dotnet.defaultSolution": "disable"
	}
}