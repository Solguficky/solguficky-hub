{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build (debug)",
            "type": "shell",
            "command": "cargo build"
        },
        {
            "label": "cargo build telegram-gateway (debug)",
            "type": "shell",
            "command": "cargo build",
            "options": {
                "cwd": "${workspaceFolder}/legacy/telegram-gateway"
            }
        },
        {
            "label": "cargo test",
            "type": "shell",
            "command": "cargo nextest run --all --quiet"
        },
        {
            "label": "cargo clippy",
            "type": "shell",
            "command": "cargo clippy --all-targets --all-features -D warnings"
        },
        {
            "label": "watch",
            "type": "shell",
            "command": "cargo watch -x 'check -q'"
        }
    ]
}