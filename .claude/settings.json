{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "just check-agent-tools || exit 2",
            "if": "Edit(.skillshare/**)",
            "statusMessage": "Проверяю раскладку agent tooling"
          },
          {
            "type": "command",
            "command": "just identity-proto || exit 2",
            "if": "Edit(contracts/proto/**)",
            "statusMessage": "Проверяю Identity-кодогенерацию"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  }
}
