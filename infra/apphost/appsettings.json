{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Topology": {
    "Profile": "core",
    "Profiles": {
      "infra": {
        "Infrastructure": [ "postgres", "nats" ]
      },
      "identity": {
        "Services": [ "identity" ],
        "Infrastructure": [ "postgres" ]
      },
      "core": {
        "Services": [ "identity", "telegram-bot" ],
        "Infrastructure": [ "postgres" ]
      },
      "full": {
        "Services": [ "identity", "telegram-bot" ],
        "Infrastructure": [ "postgres", "nats" ]
      }
    }
  }
}
