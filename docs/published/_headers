# Заголовки ответов Netlify: файл в корне публикуемого каталога читает сам Netlify.
# Совпавшие правила складываются.

# PowerPoint-караоке — страница вечеринки, не для поиска.
/karaoke/*
  X-Robots-Tag: noindex, nofollow

# Слайды не меняются: неделя кэша, чтобы повторный показ не качал их заново.
/karaoke/slides/*
  Cache-Control: public, max-age=604800
