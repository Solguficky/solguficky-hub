# ===================================================================
# Как поддерживать этот файл
# ===================================================================
#
# Здесь перечисляются только языки и инструменты, которые в репозитории
# действительно используются. Секция стека заводится вместе с первым
# сервисом на нём, а не заранее «на будущее»: правило, которое ничего
# не игнорирует, невозможно проверить и оно устаревает незаметно.
#
# Компоненты живут в подкаталогах, поэтому правила пишутся без привязки
# к корню: `dist/`, а не `/dist/`. Правило, осмысленное только внутри
# одного компонента, живёт в его собственном .gitignore.

# ===================================================================
# Общее
# ===================================================================

# Логи и временные файлы
*.log
*.log.*
logs/
tmp/
*.tmp
*.temp

# Файлы операционной системы
.DS_Store
Thumbs.db

# Файлы IDE и редакторов
# Visual Studio Code / Cursor
# .vscode/ не игнорируется: переносимые между машинами конфигурации коммитятся.
.cursor-project
# JetBrains (Rider, IntelliJ)
.idea/
# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# Локальные переопределения git-хуков (см. lefthook.yml)
lefthook-local.yml

# Рабочие деревья параллельных задач (см. docs/standards/git/branching.md).
# Дерево лежит внутри репозитория, поэтому без этого правила оно попадает
# в git status основного дерева, а грязное дерево останавливает создание
# следующей ветки.
.claude/worktrees/

# Таргеты skillshare — сгенерированный артефакт (ADR-041). Каталоги собирает
# `skillshare sync -p` из источника .skillshare/skills/ на каждой машине;
# внешние скиллы перед этим ставит `just skillshare-install`.
#
# Закоммиченная копия ничего не добавляла к доступности: sync раскладывает
# `proj-`скиллы из Git без сети. Зато в дереве без внешних источников он
# считал закоммиченные каталоги осиротевшими и молча их удалял.
.claude/skills/
.agents/skills/
# Таргет agents объявлен в config.yaml у claude и тоже раскладывается копией.
# Источников агентов в репозитории пока нет, но правило заводится вместе с
# путём: иначе первый же агент приедет в отслеживаемый каталог сгенерированным.
.claude/agents/

# ===================================================================
# Окружение
# ===================================================================

# Переменные окружения (никогда не коммитить секреты!)
.env

# Конфигурация Railway (если используется CLI)
.railway/

# ===================================================================
# .NET / C# / F# — infra/apphost, shared/dotnet, apps/meetups
# ===================================================================

# Папки с бинарниками и временными файлами
[Bb]in/
[Oo]bj/
# Nuget-пакеты (обычно не хранятся в репозитории)
packages/
# Пользовательские секреты AppHost (токены ботов и т.п.) хранятся вне репозитория
.aspire/

# ===================================================================
# Go — apps/identity
# ===================================================================

*.exe
*.exe~
*.test
*.out
vendor/
# Собранный бинарник: `go build -o` кладёт его сюда из AppHost
bin/

# ===================================================================
# Node.js — apps/telegram-bot
# ===================================================================

node_modules/
npm-debug.log*
.npm/
dist/
coverage/
*.tsbuildinfo

# ===================================================================
# Python — tools/nats-tester
# ===================================================================

__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
