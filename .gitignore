# ===================================================================
# Общие правила для всех проектов и операционных систем
# ===================================================================

# Логи и временные файлы
*.log
logs/
*.log.*
*.tmp
*.temp

# Файлы операционной системы
.DS_Store
Thumbs.db

# Файлы IDE и редакторов
# Visual Studio Code / Cursor
.vscode/
.cursor-project
# JetBrains (Rider, IntelliJ)
.idea/
# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# ===================================================================
# Правила для окружения
# ===================================================================

# Переменные окружения (никогда не коммитить секреты!)
.env

# Конфигурация Railway (если используется CLI)
.railway/

# ===================================================================
# Правила для конкретных языков и фреймворков
# ===================================================================

# --- .NET / C# (Events, Users, Achievements, Content Services) ---
# Папки с бинарниками и временными файлами
[Bb]in/
[Oo]bj/
# Nuget-пакеты (обычно не хранятся в репозитории)
packages/

# --- .NET Aspire (infra/apphost) ---
# Пользовательские секреты AppHost (токены ботов и т.п.) хранятся вне репозитория
.aspire/

# --- Rust (API Gateway) ---
# Папка сборки Cargo
**/target/
# Исполняемые файлы, которые могут быть созданы в корне папки
*.rs.bk
# Не игнорируем Cargo.lock, так как он обеспечивает воспроизводимость сборок.
# Cargo.lock

# --- Scala (Auction Service) ---
# Папки сборки sbt
/target/
/project/project/
/project/target/
# Метаданные Metals IDE (языковой сервер)
.metals/
.bloop/

# --- Elixir (Notifications, Real-Time Hub) ---
# Папка сборки Mix и зависимости
/_build/
/deps/
# Файлы, генерируемые ElixirLS (языковой сервер)
/.elixir_ls/
# Логи креш-репортов Erlang VM
erl_crash.dump

# --- Go (Если будете добавлять сервисы на Go) ---
# Исполняемые файлы, скомпилированные `go build`
# Обычно их называют по имени проекта, например, `events-service`
*.exe
*.exe~
# Не игнорируем go.sum, он фиксирует версии зависимостей
# go.sum

# --- Node.js / TypeScript (Big Screen App, Admin Panel) ---
# Зависимости
/node_modules/
# Логи менеджеров пакетов
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Сборочные артефакты
/dist/
/.dist/
/.output/
# Next.js
/.next/
# SvelteKit
/.svelte-kit/
# Nuxt.js
/.nuxt/
# Vite
/.vite/
# Тестовые репорты и кэш
/coverage/
.nyc_output/
.fake