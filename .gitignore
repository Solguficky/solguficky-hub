# ===================================================================
# Как поддерживать этот файл
# ===================================================================
#
# Здесь перечисляются только языки и инструменты, которые в репозитории
# действительно используются. Секция стека заводится вместе с первым
# сервисом на нём, а не заранее «на будущее»: правило, которое ничего
# не игнорирует, невозможно проверить и оно устаревает незаметно.
#
# Компоненты живут в подкаталогах, поэтому правила пишутся без привязки
# к корню: `dist/`, а не `/dist/`. Правило, осмысленное только внутри
# одного компонента, живёт в его собственном .gitignore.

# ===================================================================
# Общее
# ===================================================================

# Логи и временные файлы
*.log
*.log.*
logs/
tmp/
*.tmp
*.temp

# Файлы операционной системы
.DS_Store
Thumbs.db

# Файлы IDE и редакторов
# Visual Studio Code / Cursor
# .vscode/ отслеживается: launch.json и tasks.json переносимы между машинами.
.cursor-project
# JetBrains (Rider, IntelliJ)
.idea/
# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# Локальные переопределения git-хуков (см. lefthook.yml)
lefthook-local.yml

# ===================================================================
# Окружение
# ===================================================================

# Переменные окружения (никогда не коммитить секреты!)
.env

# Конфигурация Railway (если используется CLI)
.railway/

# ===================================================================
# .NET / C# — legacy/*, infra/apphost, shared/dotnet
# ===================================================================

# Папки с бинарниками и временными файлами
[Bb]in/
[Oo]bj/
# Nuget-пакеты (обычно не хранятся в репозитории)
packages/
# Пользовательские секреты AppHost (токены ботов и т.п.) хранятся вне репозитория
.aspire/

# ===================================================================
# Rust — legacy/telegram-gateway
# ===================================================================

# Папка сборки Cargo
**/target/
*.rs.bk
# Не игнорируем Cargo.lock, так как он обеспечивает воспроизводимость сборок.

# ===================================================================
# Python — tools/nats-tester
# ===================================================================

__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# ===================================================================
# Go — apps/identity
# ===================================================================

# Protobuf types are generated from contracts/proto/ during the build.
apps/identity/gen/
