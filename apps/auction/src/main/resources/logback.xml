<?xml version="1.0" encoding="UTF-8"?>
<!--
  Логи сервиса — JSON: каркас полей из docs/standards/observability/logging.md
  читается запросом `| json | <поле>=…` в Loki.

  Поле service объявлено здесь, а не в коде: стандарт требует константы сборки,
  а не метки сборщика логов, и одна строка конфигурации избавляет каждую запись
  от передачи имени сервиса руками.
-->
<configuration>
  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"auction"}</customFields>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
    </encoder>
  </appender>

  <!--
    Уровень кода сервиса — AUCTION_LOG_LEVEL, корень остаётся INFO: на DEBUG
    grpc-java пишет каждый кадр HTTP/2, а Netty и пул соединений — свою кухню,
    и квоту источника съели бы библиотеки, а не сервис (ADR-053, дополнение 2026-10-15).
  -->
  <logger name="auction" level="${AUCTION_LOG_LEVEL:-INFO}"/>

  <root level="INFO">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
