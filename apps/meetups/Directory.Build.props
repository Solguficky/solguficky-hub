<Project>

  <!-- Неполный match — ошибка сборки в каждом проекте Meetups, и в тех, что
       появятся под этим каталогом: пропущенный вариант отказа иначе остаётся
       предупреждением FS0025, сборка и гейт проходят зелёными, а пропуск всплывает
       исключением в рантайме (PER-457). Остальные предупреждения не трогаются:
       общий TreatWarningsAsErrors превратил бы правило полноты в правило про всё. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
  </PropertyGroup>

</Project>
