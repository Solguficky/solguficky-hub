<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Порядок Compile — направление зависимостей: файл видит только объявленное
       выше. Domain/ стоит первым и потому не способен увидеть транспорт.
       Slices/ и Infrastructure/ появятся вместе с записью и gRPC-слоем. -->
  <ItemGroup>
    <Compile Include="Domain/Ids.fs" />
    <Compile Include="Domain/Viewer.fs" />
    <Compile Include="Domain/Schedule.fs" />
    <Compile Include="Domain/MeetupMaterial.fs" />
    <Compile Include="Domain/MeetupSnapshot.fs" />
    <Compile Include="Domain/MeetupTransitions.fs" />
    <Compile Include="Domain/Access.fs" />
    <Compile Include="Domain/Archive.fs" />
    <Compile Include="Domain/Meetup.fs" />
    <Compile Include="RequestId.fs" />
    <Compile Include="Migrations.fs" />
    <Compile Include="Infrastructure/Db.fs" />
    <Compile Include="Infrastructure/CommunityTime.fs" />
    <Compile Include="Infrastructure/MeetupRow.fs" />
    <Compile Include="Infrastructure/MeetupEventPayload.fs" />
    <Compile Include="Infrastructure/MeetupStore.fs" />
    <Compile Include="Infrastructure/MeetupReading.fs" />
    <Compile Include="Infrastructure/DuePublicationStore.fs" />
    <Compile Include="Infrastructure/DispatchStore.fs" />
    <Compile Include="Slices/Contract.fs" />
    <Compile Include="Slices/SafeRetry.fs" />
    <Compile Include="Slices/CreateMeetupDraft.fs" />
    <Compile Include="Slices/ChangeMeetupAttributes.fs" />
    <Compile Include="Slices/SetMeetupSchedule.fs" />
    <Compile Include="Slices/PublishMeetup.fs" />
    <Compile Include="Slices/ScheduleMeetupPublication.fs" />
    <Compile Include="Slices/CancelMeetupPublication.fs" />
    <Compile Include="Slices/UnpublishMeetup.fs" />
    <Compile Include="Slices/CancelMeetup.fs" />
    <Compile Include="Slices/AttachMaterial.fs" />
    <Compile Include="Slices/RemoveMaterial.fs" />
    <Compile Include="Slices/MarkMeetupHeld.fs" />
    <Compile Include="Slices/ListVisibleMeetups.fs" />
    <Compile Include="Slices/ListArchivedMeetups.fs" />
    <Compile Include="Slices/GetMeetup.fs" />
    <Compile Include="Slices/ListMeetupStates.fs" />
    <Compile Include="Slices/CheckMeetupAuthority.fs" />
    <Compile Include="Slices/DispatchMeetupEvents.fs" />
    <Compile Include="Slices/PublishDueMeetups.fs" />
    <Compile Include="Observability/Failures.fs" />
    <Compile Include="Observability/DispatchTelemetry.fs" />
    <Compile Include="Observability/PublisherTelemetry.fs" />
    <Compile Include="Observability/DuePublicationTelemetry.fs" />
    <Compile Include="Observability/IncomingMetadata.fs" />
    <Compile Include="Observability/BoundaryLog.fs" />
    <Compile Include="Transport/MeetupsGrpcService.fs" />
    <Compile Include="Transport/IdentityRoleClient.fs" />
    <Compile Include="Transport/NatsEventPublisher.fs" />
    <Compile Include="Transport/OutboxDispatchWorker.fs" />
    <Compile Include="Transport/DuePublicationWorker.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="Program.fs" />
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.NATS.Net" Version="13.5.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.67.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.67.0" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meetups.Contracts\Meetups.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\dotnet\ServiceDefaults\ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
