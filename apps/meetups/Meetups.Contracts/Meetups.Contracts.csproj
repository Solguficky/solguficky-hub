<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\contracts\proto\identity\v1\roles.proto" GrpcServices="None" ProtoRoot="..\..\..\contracts\proto" />
    <!-- Клиент, а не сервер: Meetups спрашивает у Identity глобальную роль для
         отношения «администратор» в CheckMeetupAuthority (ADR-051, п. 4). -->
    <Protobuf Include="..\..\..\contracts\proto\identity\v1\identity_service.proto" GrpcServices="Client" ProtoRoot="..\..\..\contracts\proto" />
    <Protobuf Include="..\..\..\contracts\proto\meetups\v1\meetups.proto" GrpcServices="None" ProtoRoot="..\..\..\contracts\proto" />
    <Protobuf Include="..\..\..\contracts\proto\meetups\v1\meetups_events.proto" GrpcServices="None" ProtoRoot="..\..\..\contracts\proto" />
    <Protobuf Include="..\..\..\contracts\proto\meetups\v1\meetups_service.proto" GrpcServices="Both" ProtoRoot="..\..\..\contracts\proto" />
  </ItemGroup>

</Project>
