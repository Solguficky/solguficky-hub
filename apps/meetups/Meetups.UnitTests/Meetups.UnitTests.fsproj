<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test project is an executable: the entry point comes from the runner. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Unquote" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestUtilities/TestData/Sample.fs" />
    <Compile Include="DomainTests/ScheduleTests.fs" />
    <Compile Include="DomainTests/CreateMeetupDraftTests.fs" />
    <Compile Include="DomainTests/ChangeMeetupAttributesTests.fs" />
    <Compile Include="DomainTests/SetMeetupScheduleTests.fs" />
    <Compile Include="DomainTests/PublishMeetupTests.fs" />
    <Compile Include="DomainTests/AccessTests.fs" />
    <Compile Include="DomainTests/MeetupApplyTests.fs" />
    <Compile Include="DomainTests/MeetupRehydrateTests.fs" />
    <Compile Include="InfrastructureTests/MeetupRowTests.fs" />
    <Compile Include="InfrastructureTests/MeetupEventPayloadTests.fs" />
    <Compile Include="SliceTests/ContractTests.fs" />
    <Compile Include="SliceTests/CreateMeetupDraftWorkflowTests.fs" />
    <Compile Include="SliceTests/SetMeetupScheduleWorkflowTests.fs" />
    <Compile Include="SliceTests/PublishMeetupWorkflowTests.fs" />
    <Compile Include="ContractSurfaceTests.fs" />
    <Compile Include="PlaceholderTests.fs" />
    <Compile Include="BoundaryLogTests.fs" />
    <Compile Include="MigrationsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meetups.Contracts\Meetups.Contracts.csproj" />
    <ProjectReference Include="..\Meetups.TestKit\Meetups.TestKit.fsproj" />
    <ProjectReference Include="..\Meetups\Meetups.fsproj" />
  </ItemGroup>

</Project>
