{
  "name": "@solguficky/auction-bot-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./contract": {
      "types": "./dist/src/contract/index.d.ts",
      "default": "./dist/src/contract/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
